node_modules/
dist/

# devsave writes <file>.tmp and renames it into place. A crash between the two
# leaves one behind, and `git add -A` can catch one mid-write.
*.tmp

# scratch output from the verify tools
.verify-tmp/

# the verify tools each get their own scratch dir
.verify-level/
.inspect-level/
.verify-diag*/
.stats-tmp/
.fl-tmp/

# tools/measure.py is imported by tools/measure-scifi.py
__pycache__/
