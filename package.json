{
  "name": "game",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "play": "node tools/play.mjs",
    "publish": "node tools/publish.mjs",
    "update": "node tools/update-play.mjs",
    "verify:enemies": "node tools/verify-enemies.mjs",
    "verify:slam": "node tools/verify-slam.mjs",
    "verify:wing": "node tools/verify-wing.mjs",
    "verify:gas": "node tools/verify-gas.mjs",
    "verify:vault": "node tools/verify-vault.mjs",
    "verify:collision": "node tools/verify-collision.mjs",
    "verify:sound": "node tools/verify-sound.mjs",
    "verify": "npm run verify:slam && npm run verify:wing && npm run verify:gas && npm run verify:vault && npm run verify:collision && npm run verify:sound && npm run verify:enemies && npm run verify:boxselect && npm run verify:level && npm run verify:level:raw && npm run verify:level:cyber",
    "verify:boxselect": "node tools/verify-boxselect.mjs",
    "deploy": "node tools/publish.mjs",
    "verify:level": "node tools/verify-level.mjs",
    "verify:level:raw": "node -e \"process.env.LEVEL='raw';import('./tools/verify-level.mjs')\"",
    "verify:level:cyber": "node -e \"process.env.LEVEL='cyber';import('./tools/verify-level.mjs')\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.185.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "type": "module"
}
